<?xml version="1.0" encoding="UTF-8"?>
<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			 xmlns="http://appconfig.aura.nav.no"
			 xsi:schemaLocation="http://appconfig.aura.nav.no http://maven.adeo.no/xsd/appconfig.xsd">

	<name>varsel</name>

	<selftest>
		<path>/varsel/internal/selftest</path>
	</selftest>

	<loadBalancer isAlive="/varsel/internal/isAlive"/>

	<artifacts>
		<ear groupId="no.nav.varsel" artifactId="varsel-jee"/>
		<batch groupId="no.nav.varsel" artifactId="varsel-batch-client" symlink="/data/batch/varsel/"/>
	</artifacts>

	<resources>
		<datasource alias="varselDS" jndi="java:/jboss/datasources/varselXADS" type="ORACLE" xaEnabled="true">
			<pool maxPoolSize="50"/>
		</datasource>
		<datasource alias="varselDS" jndi="java:/jboss/datasources/varselDS" type="ORACLE">
			<pool maxPoolSize="50"/>
		</datasource>
		<queueManager alias="mqGateway02" jndi="java:/jboss/mqConnectionFactory" xaEnabled="true"
					  unifiedConnectionFactory="true">
			<queue alias="VARSELPRODUKSJON.VARSLINGER" jndi="java:/jboss/bestillServicemelding"/>
			<queue alias="VARSELPRODUKSJON.KVITTERING" jndi="java:/jboss/varselKvittering"/>
			<queue alias="VARSEL_INN" jndi="java:/jboss/varselutsending"/>
			<queue alias="VARSELPRODUKSJON.BEST_VARSEL_M_HANDLING" jndi="java:/jboss/bestillVarsel"/>
			<queue alias="VARSELPRODUKSJON.STOPP_VARSEL_UTSENDING" jndi="java:/jboss/revarselStopp"/>
			<queue alias="VARSELPRODUKSJON.BEST_SRVMLD_M_KONTAKT" jndi="java:/jboss/bestillServicemeldingKontaktInfo"/>
		</queueManager>
		<ldap alias="ldap" mapToProperty="ldap"/>
		<baseUrl alias="securityTokenService" mapToProperty="securityTokenService"/>
		<soap mapToProperty="dkif.ws" alias="virksomhet:DigitalKontaktinformasjon_v1"/>
		<baseUrl alias="pdl" mapToProperty="pdl"/>
		<rest alias="VarselInfo_v1" mapToProperty="dokkat.varselinfo.rest"/>
		<rest alias="security-token-service-token" mapToProperty="securityTokenRestService"/>
		<applicationProperties alias="varselProps"/>
	</resources>

	<exposed-services>
		<exposedQueue name="VARSELPRODUKSJON.VARSLINGER"/>
		<exposedQueue name="VARSELPRODUKSJON.KVITTERING"/>
		<exposedQueue name="VARSELPRODUKSJON.BEST_VARSEL_M_HANDLING"/>
		<exposedQueue name="VARSELPRODUKSJON.STOPP_VARSEL_UTSENDING"/>
		<exposedQueue name="VARSELPRODUKSJON.BEST_SRVMLD_M_KONTAKT"/>
	</exposed-services>

	<security serviceUserResourceAlias="srvVarsel">
		<logins>
			<saml/>
		</logins>
	</security>

	<monitoring>
		<metric path="/varsel/internal/metrics"/>
	</monitoring>

</application>