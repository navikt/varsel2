<?xml version="1.0" encoding="UTF-8"?>
<application xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			 xmlns="http://appconfig.aura.nav.no"
			 xsi:schemaLocation="http://appconfig.aura.nav.no http://maven.adeo.no/xsd/appconfig.xsd">

	<name>Varsel</name>

	<selftest>
		<path>/varsel/internal/selftest?status</path>
		<humanReadablePath>/varsel/internal/selftest</humanReadablePath>
	</selftest>

	<loadBalancer isAlive="/varsel/internal/isAlive"/>

	<artifacts>
		<ear groupId="no.nav.varsel" artifactId="varsel-jee"/>
	</artifacts>

	<resources>
		<datasource alias="varselDS" jndi="java:/jboss/datasources/varselDS" type="ORACLE" xaEnabled="true">
			<pool maxPoolSize="50"/>
		</datasource>
		<queueManager alias="mqGateway02" jndi="java:/jboss/mqConnectionFactory" xaEnabled="true"
					  unifiedConnectionFactory="true">
			<queue alias="VARSELPRODUKSJON.VARSLINGER" jndi="java:/jboss/bestillServicemelding"/>
			<queue alias="VARSELPRODUKSJON.KVITTERING" jndi="java:/jboss/varselKvittering"/>
			<queue alias="VARSEL_INN" jndi="java:/jboss/varselutsending"/>
			<queue alias="varsel_bestill_varsel" jndi="java:/jboss/bestillVarsel"/>
		</queueManager>
		<ldap alias="ldap" mapToProperty="ldap"/>
		<webservice mapToProperty="aktoerv2.ws" alias="Aktoer_v2"/>
		<webservice mapToProperty="dkif.ws" alias="virksomhet:DigitalKontakinformasjon_v1"/>
		<rest alias="VarselInfo_v1" mapToProperty="dokkat.varselinfo.rest"/>
		<applicationProperties alias="varselProps"/>
	</resources>

	<exposed-services>
		<exposedQueue name="VARSELPRODUKSJON.VARSLINGER"/>
		<exposedQueue name="VARSELPRODUKSJON.KVITTERING"/>
		<exposedQueue name="varsel_bestill_varsel"/>
	</exposed-services>

	<security serviceUserResourceAlias="srvVarsel"/>

	<monitoring>
		<metric path="/varsel/internal/metrics"/>
	</monitoring>

</application>