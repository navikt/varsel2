		<dependency>
			<groupId>no.nav.varsel</groupId>
			<artifactId>kvarsel001</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
